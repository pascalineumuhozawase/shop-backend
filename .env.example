NODE_ENV=development
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=7d
# Set this to the Neon connection string and include ?sslmode=require.
DATABASE_URL=
# These settings are only used when DATABASE_URL is empty (local PostgreSQL).
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=online_shopping_db
SHIPPING_FEE=8
FREE_SHIPPING_THRESHOLD=100